# PostgreSQL (Docker host port 5433 → container 5432)
DATABASE_URL=postgresql://zioncredit:zion_dev_password@localhost:5433/zion_credit

# Redis
REDIS_URL=redis://localhost:6379

# MinIO / S3-compatible storage
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=zioncredit
MINIO_SECRET_KEY=zion_minio_dev_password
MINIO_BUCKET=zion-credit-documents
MINIO_REGION=us-east-1
# Opcional: endpoint público do MinIO para URLs assinadas diretas no browser.
# Sem isso, a visualização usa proxy autenticado via /api/v1/documents/:id/content (recomendado no Docker).
# MINIO_PUBLIC_ENDPOINT=minio.seudominio.com
# MINIO_PUBLIC_PORT=9000
# MINIO_PUBLIC_USE_SSL=true

# Auth (JWT + httpOnly cookie)
AUTH_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
AUTH_COOKIE_NAME=zion_session
AUTH_TOKEN_TTL_HOURS=12

# App
APP_URL=http://localhost:3000
NODE_ENV=development
LOG_LEVEL=info

# Upload limits
MAX_UPLOAD_BYTES=20971520

# Document Intelligence / AI
# mock | openai — never expose keys to the frontend
AI_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
AI_CLASSIFICATION_AUTO_THRESHOLD=0.90
AI_CLASSIFICATION_REVIEW_THRESHOLD=0.70
# Optional forced mock scenario: SUCCESS | LOW_CONFIDENCE | NAME_MISMATCH | CPF_MISMATCH | INVALID_JSON | PROVIDER_ERROR | OCR_ERROR
MOCK_AI_SCENARIO=
DOCUMENT_WORKER_CONCURRENCY=2
FINANCIAL_WORKER_CONCURRENCY=2
# Notification / CRM
NOTIFICATION_PROVIDER=mock
EMAIL_PROVIDER_URL=
WHATSAPP_PROVIDER_URL=
# Header x-zion-webhook-secret para POST /api/v1/webhooks/crm
CRM_WEBHOOK_SECRET=

# OCR — mock | openai (se vazio, segue AI_PROVIDER)
OCR_PROVIDER=
OPENAI_OCR_MODEL=gpt-4o-mini

# Go-live
LOGIN_RATE_LIMIT_MAX=10
LOGIN_RATE_LIMIT_WINDOW_SEC=900
# Em produção o seed NÃO cria usuários demo, salvo:
ALLOW_DEMO_SEED=false

# FASE 7.1 Caixa SDK (opcional — desligado por padrão)
# Também precisa ligar em Configurações do escritório + autorização do cliente no processo
CAIXA_SDK_ENABLED=false
CAIXA_API_URL=
CAIXA_API_TOKEN=
CAIXA_TOKEN_URL=
CAIXA_CLIENT_ID=
CAIXA_CLIENT_SECRET=
CAIXA_OAUTH_SCOPE=
CAIXA_SUBMIT_PATH=/v1/propostas
CAIXA_TRACK_PATH=/v1/propostas/{ref}
FINANCING_PROVIDER=mock
FINANCING_PROVIDER_URL=
FINANCING_PROVIDER_TOKEN=

