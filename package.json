{
  "name": "zion-credit",
  "version": "0.1.0",
  "private": true,
  "description": "ZION CREDIT — Plataforma de Análise Documental e Pré-Crédito Imobiliário",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed.ts",
    "db:up": "docker compose up -d postgres redis minio minio-init",
    "db:down": "docker compose down",
    "infra:up": "docker compose up -d",
    "infra:reset": "docker compose down -v && docker compose up -d",
    "setup": "pnpm db:up && pnpm db:migrate && pnpm db:seed",
    "infra:check": "tsx src/scripts/check-infra.ts",
    "workers": "tsx src/workers/run-workers.ts",
    "workers:documents": "tsx src/workers/run-workers.ts",
    "go-live:check": "tsx src/scripts/assert-production.ts",
    "db:catalog": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.1.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "file-type": "^22.0.2",
    "ioredis": "^6.0.0",
    "jose": "^6.2.9",
    "lucide-react": "^1.33.0",
    "minio": "^8.0.7",
    "nanoid": "^6.0.1",
    "next": "16.3.1",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^3.0.0",
    "@types/minio": "^7.1.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.9.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "msgpackr-extract",
      "unrs-resolver"
    ]
  }
}
